# ==============================================================================
# RojgarMitra Environment Configuration Template (.env.example)
# Do NOT commit secrets or actual private keys to Git.
# Copy this file to .env.local for local development.
# ==============================================================================

# Public Client-side Firebase Configuration (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rojgarmitra-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Server-side Firebase Admin SDK (Vercel Serverless / Local Node)
FIREBASE_PROJECT_ID=rojgarmitra-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rojgarmitra-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# AI & Voice Integrations (Server-side Only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-marathi-hindi-voice-id

# External APIs (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
YOUTUBE_API_KEY=your-youtube-api-key
SMS_PROVIDER_KEY=your-sms-api-key

# Application Mode
APP_MODE=demo
