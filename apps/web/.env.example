# ==============================================================================
# Web App & Backend API Environment Configuration Template
# Copy this to .env.local for local execution or import to Vercel.
# NEVER commit real API keys or sensitive values to Git.
# ==============================================================================

# Public Web Client-side Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-side Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# AI Models (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Independent Web Search (Tavily Search API)
TAVILY_API_KEY=your-tavily-api-key

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Voice & Speech (ElevenLabs Pro)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_VOICE_ID_FEMALE_MR=your-female-mr-voice-id
ELEVENLABS_VOICE_ID_MALE_HI=your-male-hi-voice-id
ELEVENLABS_VOICE_ID_FEMALE_HI=your-female-hi-voice-id
ELEVENLABS_VOICE_ID_EN=your-en-voice-id

# Sarvam AI (Optional Fallback)
SARVAM_API_KEY=

# Application Mode
APP_MODE=production
